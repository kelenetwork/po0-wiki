#!/usr/bin/env bash
set -euo pipefail

readonly ipv4_url='https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china.txt'
readonly ipv6_url='https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china6.txt'
readonly state_dir='/var/lib/wiki-probe-cn-firewall-controller'
readonly generator='/usr/local/libexec/wiki-probe-cn-firewall-generate'
readonly remote_apply='/usr/local/libexec/wiki-probe-cn-firewall-remote-apply'
readonly run_remote_bash='/root/.openclaw/workspace/tools/run-remote-bash'
readonly identity_file='/root/.openclaw/secrets/fleet/keys/po0-official-2026.key'
readonly -a targets=('43.142.145.131' '106.52.236.170')

for cmd in curl python3 nft ssh-agent ssh-add scp flock; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'Missing dependency: %s\n' "$cmd" >&2
    exit 69
  }
done
for path in "$generator" "$remote_apply" "$run_remote_bash" "$identity_file"; do
  [[ -r "$path" ]] || {
    printf 'Required file is not readable: %s\n' "$path" >&2
    exit 66
  }
done

install -d -m 0755 "$state_dir"
exec 9>"$state_dir/update.lock"
flock -n 9 || {
  printf '%s\n' 'Another firewall update is already running' >&2
  exit 75
}

work_dir=$(mktemp -d "$state_dir/update.XXXXXX")
agent_started=false
cleanup() {
  rm -rf "$work_dir"
  if [[ "$agent_started" == true ]]; then
    ssh-agent -k >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

curl --fail --location --silent --show-error \
  --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 \
  "$ipv4_url" --output "$work_dir/china.txt"
curl --fail --location --silent --show-error \
  --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 \
  "$ipv6_url" --output "$work_dir/china6.txt"
python3 "$generator" "$work_dir/china.txt" "$work_dir/china6.txt" "$work_dir/rules.nft"
nft --check --file "$work_dir/rules.nft"

# The key has no passphrase and is never copied to either entry node.
eval "$(ssh-agent -s)" >/dev/null
agent_started=true
ssh-add "$identity_file" >/dev/null

update_target() {
  local host=$1
  local attempt
  for attempt in 1 2 3; do
    if scp -P 22 \
      -o StrictHostKeyChecking=yes \
      -o BatchMode=yes \
      -o ConnectTimeout=20 \
      -o ConnectionAttempts=1 \
      "$work_dir/rules.nft" "root@$host:/root/wiki-probe-cn-rules.pending.nft"; then
      if "$run_remote_bash" "$host" 22 "$remote_apply"; then
        return 0
      fi
    fi
    printf 'Target %s update attempt %s/3 failed\n' "$host" "$attempt" >&2
    if ((attempt < 3)); then
      sleep $((attempt * 5))
    fi
  done
  return 1
}

for host in "${targets[@]}"; do
  update_target "$host"
done

install -m 0644 "$work_dir/rules.nft" "$state_dir/rules.nft"
date --iso-8601=seconds >"$state_dir/last-success"
printf 'CONTROLLER_UPDATE_COMPLETE targets=%s\n' "${#targets[@]}"
