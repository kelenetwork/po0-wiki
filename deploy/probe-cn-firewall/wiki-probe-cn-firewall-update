#!/usr/bin/env bash
set -euo pipefail

readonly ipv4_url='https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china.txt'
readonly ipv6_url='https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china6.txt'
readonly state_dir='/var/lib/wiki-probe-cn-firewall'
readonly config_dir='/etc/wiki-probe-cn-firewall'
readonly generator='/usr/local/libexec/wiki-probe-cn-firewall-generate'
readonly apply_rules='/usr/local/sbin/wiki-probe-cn-firewall-apply'

for cmd in curl python3 nft systemctl flock; do
  command -v "$cmd" >/dev/null 2>&1 || {
    printf 'Missing dependency: %s\n' "$cmd" >&2
    exit 69
  }
done
for path in "$generator" "$apply_rules"; do
  [[ -x "$path" ]] || {
    printf 'Required helper is not executable: %s\n' "$path" >&2
    exit 66
  }
done

# Reuse the HTTP(S) proxy already configured for wiki-probe-agent. This keeps
# one authoritative proxy setting and does not copy credentials into another
# environment file or unit.
env_line=$(systemctl show wiki-probe-agent.service -p Environment --value)
mapfile -t assignments < <(
  python3 -c 'import shlex,sys; print("\n".join(shlex.split(sys.stdin.read())))' <<<"$env_line"
)
proxy_url=''
for assignment in "${assignments[@]}"; do
  case "$assignment" in
    HTTPS_PROXY=*|https_proxy=*) proxy_url=${assignment#*=}; break ;;
  esac
done
if [[ -z "$proxy_url" ]]; then
  for assignment in "${assignments[@]}"; do
    case "$assignment" in
      HTTP_PROXY=*|http_proxy=*) proxy_url=${assignment#*=}; break ;;
    esac
  done
fi
[[ -n "$proxy_url" ]] || {
  printf '%s\n' 'wiki-probe-agent has no HTTP(S) proxy configured' >&2
  exit 78
}

install -d -m 0755 "$state_dir" "$config_dir"
exec 9>"$state_dir/update.lock"
flock -n 9 || {
  printf '%s\n' 'Another firewall update is already running' >&2
  exit 75
}
work_dir=$(mktemp -d "$state_dir/update.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT

for name in china.txt china6.txt; do
  curl --proxy "$proxy_url" --fail --location --silent --show-error \
    --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 \
    "https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/$name" \
    --output "$work_dir/$name"
done

python3 "$generator" "$work_dir/china.txt" "$work_dir/china6.txt" "$work_dir/rules.nft"
"$apply_rules" "$work_dir/rules.nft"
install -m 0644 "$work_dir/rules.nft" "$config_dir/rules.nft"
date --iso-8601=seconds >"$state_dir/last-success"
printf '%s\n' 'NODE_UPDATE_COMPLETE'
