#!/usr/bin/env bash
set -euo pipefail

readonly incoming='/root/wiki-probe-cn-rules.pending.nft'
readonly config_dir='/etc/wiki-probe-cn-firewall'
readonly apply_rules='/usr/local/sbin/wiki-probe-cn-firewall-apply'

[[ -r "$incoming" ]] || {
  printf 'Pending rules are missing: %s\n' "$incoming" >&2
  exit 66
}
[[ -x "$apply_rules" ]] || {
  printf 'Rule apply helper is missing: %s\n' "$apply_rules" >&2
  exit 69
}

# The helper validates a single nft transaction containing the existing table
# deletion plus the replacement. Checking the standalone table first would
# fail with EEXIST whenever a previous ruleset is already active.
"$apply_rules" "$incoming"
install -d -m 0755 "$config_dir" /var/lib/wiki-probe-cn-firewall
install -m 0644 "$incoming" "$config_dir/rules.nft"
date --iso-8601=seconds >/var/lib/wiki-probe-cn-firewall/last-success
rm -f "$incoming"

systemctl is-active --quiet wiki-probe-cn-firewall.service
nft list table inet wiki_probe_cn >/dev/null
printf '%s\n' 'REMOTE_APPLY_COMPLETE'
